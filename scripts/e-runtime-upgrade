#!/bin/sh
set -eu

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
  echo "usage: e-runtime-upgrade CLOSED_STATE_DIRECTORY [BACKUP_FILE]" >&2
  exit 64
fi

state_directory=$1
backup_file=${2-}
repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

export E_RUNTIME_UPGRADE_DIRECTORY="$state_directory"
export E_RUNTIME_UPGRADE_BACKUP="$backup_file"

exec emacs -Q --batch \
  -L "$repo/lisp" \
  --eval '(setq load-prefer-newer t)' \
  --eval '(let ((default-directory (car load-path))) (normal-top-level-add-subdirs-to-load-path))' \
  -l e-runtime-store-offline \
  --funcall e-runtime-store-offline-cli-main
