#!/usr/bin/env bash
set -euo pipefail

probe_usage() {
  echo "Usage: scripts/e-live-probe {ping|selected|chat|windows|symbol SYMBOL}" >&2
  exit 2
}

probe_timeout=${E_LIVE_PROBE_TIMEOUT_SECONDS:-2}
if [[ ! $probe_timeout =~ ^[1-9][0-9]*$ ]]; then
  echo "E_LIVE_PROBE_TIMEOUT_SECONDS must be a positive integer" >&2
  exit 2
fi

[[ $# -ge 1 ]] || probe_usage
probe_name=$1
shift

case $probe_name in
  ping|selected|chat|windows)
    [[ $# -eq 0 ]] || probe_usage
    probe_form="(if (fboundp 'e-dev-live-probe) (e-dev-live-probe '$probe_name) '(:ok nil :condition e-dev-live-probe-unavailable))"
    ;;
  symbol)
    [[ $# -eq 1 ]] || probe_usage
    probe_symbol=$1
    if [[ ! $probe_symbol =~ ^[-A-Za-z0-9_+*/:\<\>=!?~.]+$ ]]; then
      echo "SYMBOL contains characters that are unsafe for the fixed probe form" >&2
      exit 2
    fi
    probe_form="(if (fboundp 'e-dev-live-probe) (e-dev-live-probe 'symbol '$probe_symbol) '(:ok nil :condition e-dev-live-probe-unavailable))"
    ;;
  *)
    probe_usage
    ;;
esac

probe_client_args=(--timeout="$probe_timeout")
if [[ -n ${E_LIVE_PROBE_SOCKET_NAME:-} ]]; then
  probe_client_args+=(--socket-name "$E_LIVE_PROBE_SOCKET_NAME")
fi

exec emacsclient "${probe_client_args[@]}" --eval "$probe_form"
