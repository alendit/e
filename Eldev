;;; Eldev --- Build configuration for e -*- lexical-binding: t; -*-

;; Keep the project on Emacs' built-in ERT runner.  Eldev's defaults discover
;; the package entry point, lisp files, tests, byte-compilation targets, lint
;; tools, and package tarball from the repository and package headers.

;; Prevent macOS copy/archive helpers from materializing AppleDouble `._*'
;; metadata files in Eldev's local package install, where byte-compilation would
;; otherwise treat them as Lisp sources.
(setenv "COPYFILE_DISABLE" "1")

(let ((root (file-name-directory (or load-file-name default-directory))))
  (dolist (subdirectory
           (reverse
            '("lisp/core"
              "lisp/layers"
              "lisp/layers/agents"
              "lisp/layers/base"
              "lisp/layers/harness"
              "lisp/layers/emacs"
              "lisp/layers/evidence"
              "lisp/layers/web"
              "lisp/layers/annotations"
              "lisp/layers/org-canvas"
              "lisp/layers/project-local"
              "lisp/layers/goodnite"
              "lisp/layers/writing"
              "lisp/layers/chat"
              "lisp/defaults"
              "lisp/shells"
              "lisp/shells/chat"
              "lisp/shells/modernchat"
              "lisp/adapters/openai"
              "emacs-egui/lisp"
              "lisp/adapters/anthropic"
              "lisp/dev")))
    (add-to-list 'load-path (expand-file-name subdirectory root))))

(setf eldev-test-framework 'ert)

;; Repository test harnesses are loaded explicitly by their owning test tier;
;; they are neither runtime package files nor ordinary batch tests.
(setf eldev-main-fileset
      `(:and ,eldev-main-fileset (:not "./e2e/")))

;; Node helpers ship beside their owning Lisp modules and are resolved relative
;; to those files at runtime.  Eldev's
;; default `eldev-files-to-package' bundles only `*.el', so the packaged install
;; used by the test runner would lack the `.mjs' and the real-helper tests would
;; fail with a Node MODULE_NOT_FOUND.  Wrap the default fileset in an `:or' with
;; the helpers so they land next to their compiled modules.  (Appending to the
;; fileset instead both nests the pattern inside the default `:and' -- where a
;; file would have to match `*.el' AND the `.mjs', matching nothing -- and trips
;; Eldev's suspicious-suffix-modification warning.)
(setf eldev-files-to-package
      `(:or ,eldev-files-to-package
            "./lisp/core/e-mcp-helper.mjs"))

;; Live E2E tests intentionally sit outside the default test fileset because
;; they call real provider APIs.  Deterministic integration tests live under
;; test/ and remain part of every normal run.  Opt into the live suite with
;; E_E2E=1 outside CI, for example:
;;   E_E2E=1 eldev test -f e2e/e-live-e2e-test.el
(setf eldev-test-fileset
      (list :or eldev-test-fileset
            "./e2e/e-context-lifetime-e2e-test.el"
            "./e2e/e-post-cutover-chat-e2e-test.el"
            "./e2e/e-post-cutover-e2e-test.el"
            "./test/e-sqlite-test-store-support.el"))
(when (and (getenv "E_E2E")
           (not (getenv "CI")))
  (setf eldev-test-fileset
        (list :or eldev-test-fileset "./e2e/e-live-e2e-test.el")))

;; The bytecode smoke test inspects checkout-local source-adjacent artifacts,
;; so it is useful only when requested as a development diagnostic.
(when (getenv "E_DEV_E2E")
  (setf eldev-test-fileset
        (list :or eldev-test-fileset "./e2e/e-dev-bytecode-e2e-test.el")))

(eldev-use-package-archive 'melpa)
(eldev-add-extra-dependencies 'test '(simply-annotate (2 3 0)))
(eldev-add-extra-dependencies 'emacs 'evil 'persp-mode)

;; org-annotate is not published to a package archive.  When a local checkout is
;; present (for example the straight.el clone in the user's Emacs), add it to
;; the load path so the annotation tests can require it; otherwise those tests
;; skip themselves.
(let ((org-annotate-dir
       (seq-find
        #'file-directory-p
        (list (expand-file-name
               ".local/straight/repos/org-annotate/"
               (or (getenv "EMACS_DIR")
                   (expand-file-name "~/.config/emacs/")))
              (expand-file-name
               ".local/straight/repos/org-annotate/"
               (expand-file-name "~/.emacs.d/"))))))
  (when org-annotate-dir
    (add-to-list 'load-path org-annotate-dir)))
